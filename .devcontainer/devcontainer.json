{
  "name": "Shopsito",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  // No arranca `pnpm dev` solo: córrelo en la terminal cuando quieras.
  "overrideCommand": true,
  "postCreateCommand": "corepack enable && pnpm preparar",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
