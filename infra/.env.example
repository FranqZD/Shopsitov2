# Copia este archivo a infra/.env (ignorado por git) y llena los valores.
# Lo lee infra/desplegar.sh; sirve para dev y prod.

# My Profile → API Tokens → Create Custom Token, con permisos de cuenta:
# D1 Edit, Workers R2 Storage Edit, Workers Scripts Edit, Cloudflare Pages Edit.
CLOUDFLARE_API_TOKEN=""

# El mismo Account ID que pusiste en los terraform.tfvars.
CLOUDFLARE_ACCOUNT_ID=""

# Opcional: DSN de los proyectos de Sentry (Settings → Projects → Client Keys).
# Vacíos = no se manda nada a Sentry.
SENTRY_DSN_API=""
SENTRY_DSN_WEB=""
