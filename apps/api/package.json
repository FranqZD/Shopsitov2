{
  "name": "@shopsito/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc",
    "test": "vitest run",
    "cf-typegen": "wrangler types --include-env=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@shopsito/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
